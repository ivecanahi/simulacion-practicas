<?xml version="1.0" encoding="utf-8"?>
<model version="NetLogo 7.0.4" snapToGrid="true">
  <code><![CDATA[;; Modelo SIR en NetLogo - Práctica 04 de Simulación
;; Mismos parámetros que la versión en Python: N = 100, I0 = 5,
;; beta = 0.30, gamma = 0.10, tiempo de 0 a 100 y semilla 42.

extensions [ csv ]

globals [
  beta          ;; probabilidad de contagio por contacto
  gamma         ;; probabilidad de recuperación por tick
  python-data   ;; filas del CSV de Python: [tiempo S I R]
]

turtles-own [ state ]   ;; "S", "I" o "R"

;; Crea 100 personas susceptibles y elige 5 infectados al azar.
to setup
  clear-all
  random-seed 42
  set beta 0.30
  set gamma 0.10
  set-default-shape turtles "person"
  create-turtles 100 [
    set state "S"
    setxy random-xcor random-ycor
  ]
  ask n-of 5 turtles [ set state "I" ]
  recolor
  reset-ticks
end

;; Un tick = un paso del algoritmo de la guía.
to go
  if ticks >= 100 [ stop ]
  ;; Copia del estado: solo actúan los que eran I al inicio del tick
  ;; y solo se contagian los que eran S al inicio del tick.
  let infected-now turtles with [ state = "I" ]
  let susceptible-now turtles with [ state = "S" ]
  ;; Contagio: cada infectado elige un contacto al azar.
  ask infected-now [
    let contact one-of other turtles
    if member? contact susceptible-now and random-float 1 < beta [
      ask contact [ set state "I" ]
    ]
  ]
  ;; Recuperación con probabilidad gamma.
  ask infected-now [
    if random-float 1 < gamma [ set state "R" ]
  ]
  ;; Movimiento solo visual: el contacto se elige al azar en toda la población.
  ask turtles [ rt random 50 - 25 fd 0.5 ]
  recolor
  tick
end

to recolor
  ask turtles [
    set color ifelse-value state = "S" [ green ]
              [ ifelse-value state = "I" [ red ] [ gray ] ]
  ]
end

;; Lee resultados_python.csv (en la misma carpeta que el modelo) y lo grafica.
;; En esta parte NetLogo no genera datos: solo los importa y los representa.
to cargar-python
  ;; but-first quita la cabecera; csv convierte los números automáticamente
  set python-data but-first csv:from-file "resultados_python.csv"

  set-current-plot "Python"
  clear-plot
  foreach python-data [ row ->
    set-current-plot-pen "S" plotxy item 0 row item 1 row
    set-current-plot-pen "I" plotxy item 0 row item 2 row
    set-current-plot-pen "R" plotxy item 0 row item 3 row
  ]

  ;; Curva de Python en cada gráfico de comparación (columna 1 = S, 2 = I, 3 = R)
  foreach [ [ "Comparación S" 1 ] [ "Comparación I" 2 ] [ "Comparación R" 3 ] ] [ pair ->
    set-current-plot first pair
    set-current-plot-pen "Python"
    plot-pen-reset
    foreach python-data [ row -> plotxy item 0 row item (last pair) row ]
  ]
end
]]></code>
  <widgets>
    <button x="10" y="10" width="90" height="40" kind="Observer" forever="false" disableUntilTicks="false" display="setup">setup</button>
